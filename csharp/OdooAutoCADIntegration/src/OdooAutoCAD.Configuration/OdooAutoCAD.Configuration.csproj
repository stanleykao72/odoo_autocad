<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OdooAutoCAD.Configuration</RootNamespace>
    <AssemblyName>OdooAutoCAD.Configuration</AssemblyName>
    <Version>6.0.0</Version>
    <Authors>E-Smith</Authors>
    <Company>E-Smith</Company>
    <Product>Odoo AutoCAD Integration</Product>
    <Description>Configuration management with YAML and JSON support</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" />
    <PackageReference Include="YamlDotNet" Version="15.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OdooAutoCAD.Core\OdooAutoCAD.Core.csproj" />
  </ItemGroup>

</Project>
