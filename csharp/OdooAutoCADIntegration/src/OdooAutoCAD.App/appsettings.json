{
  "Application": {
    "Name": "Odoo AutoCAD Integration",
    "Version": "6.0.0"
  },
  "Odoo": {
    "ServerUrl": "https://odoo.example.com",
    "Database": "production",
    "Username": "",
    "TimeoutSeconds": 30
  },
  "AutoCAD": {
    "ProgId": "AutoCAD.Application",
    "ConnectionTimeoutSeconds": 10,
    "RetryAttempts": 3
  },
  "MCP": {
    "Port": 8084,
    "AutoStart": false,
    "HeartbeatIntervalSeconds": 30
  },
  "GUIProxy": {
    "PollingIntervalMs": 100,
    "DefaultTimeoutMs": 10000,
    "MaxRequestsPerBatch": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    },
    "File": {
      "Path": "logs/odoo-autocad-.log",
      "RollingInterval": "Day",
      "RetainedFileCount": 7
    }
  },
  "Database": {
    "ConnectionString": "Data Source=database.db"
  }
}
