<UserControl x:Class="OdooAutoCAD.App.Views.Controls.LogPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:OdooAutoCAD.App.Services"
             FontFamily="{StaticResource AppFontFamily}">
    <UserControl.Resources>
        <CollectionViewSource x:Key="FilteredLogEntries"
                              Source="{Binding LogEntries}"
                              Filter="FilteredLogEntries_Filter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                Padding="8,4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Source:" VerticalAlignment="Center" Margin="0,0,4,0"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox x:Name="SourceFilter" Width="120" Margin="0,0,12,0"
                          FontSize="12" SelectedIndex="0"
                          SelectionChanged="SourceFilter_SelectionChanged">
                    <ComboBoxItem Content="All"/>
                </ComboBox>

                <TextBlock Text="Level:" VerticalAlignment="Center" Margin="0,0,4,0"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox x:Name="LevelFilter" Width="100" Margin="0,0,12,0"
                          FontSize="12" SelectedIndex="0"
                          SelectionChanged="LevelFilter_SelectionChanged">
                    <ComboBoxItem Content="All"/>
                    <ComboBoxItem Content="Debug"/>
                    <ComboBoxItem Content="Info"/>
                    <ComboBoxItem Content="Warning"/>
                    <ComboBoxItem Content="Error"/>
                </ComboBox>

                <Button Content="Clear" Style="{StaticResource SecondaryButton}"
                        Padding="8,2" FontSize="11" Margin="0,0,12,0"
                        Click="ClearButton_Click"/>

                <CheckBox x:Name="AutoScrollCheckBox" Content="Auto-scroll"
                          IsChecked="True" VerticalAlignment="Center"
                          FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Log ListView -->
        <ListView x:Name="LogListView" Grid.Row="1"
                  ItemsSource="{Binding Source={StaticResource FilteredLogEntries}}"
                  Background="#FAFAFA"
                  BorderThickness="0"
                  FontFamily="Consolas, Courier New, Microsoft JhengHei"
                  FontSize="12"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Time" Width="100"
                                    DisplayMemberBinding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}"/>
                    <GridViewColumn Header="Source" Width="80"
                                    DisplayMemberBinding="{Binding Source}"/>
                    <GridViewColumn Header="Message" Width="600"
                                    DisplayMemberBinding="{Binding Message}"/>
                </GridView>
            </ListView.View>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="2,1"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Level}" Value="{x:Static services:AppLogLevel.Debug}">
                            <Setter Property="Foreground" Value="Gray"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="{x:Static services:AppLogLevel.Info}">
                            <Setter Property="Foreground" Value="Black"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="{x:Static services:AppLogLevel.Warning}">
                            <Setter Property="Foreground" Value="#E65100"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="{x:Static services:AppLogLevel.Error}">
                            <Setter Property="Foreground" Value="#C62828"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</UserControl>
