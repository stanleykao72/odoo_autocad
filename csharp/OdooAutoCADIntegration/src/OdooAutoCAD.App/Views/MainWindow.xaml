<Window x:Class="OdooAutoCAD.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Odoo AutoCAD Integration"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Side Navigation -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo/Title -->
                <Border Grid.Row="0" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="Odoo AutoCAD"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="Integration System v6.0"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Items -->
                <StackPanel Grid.Row="1" Margin="0,10">
                    <Button x:Name="BtnDashboard" Content="📊 Dashboard"
                            Style="{StaticResource NavButton}" Click="NavButton_Click"/>
                    <Button x:Name="BtnAutoCAD" Content="🔧 AutoCAD"
                            Style="{StaticResource NavButton}" Click="NavButton_Click"/>
                    <Button x:Name="BtnOdoo" Content="🏢 Odoo"
                            Style="{StaticResource NavButton}" Click="NavButton_Click"/>
                    <Button x:Name="BtnBOQ" Content="📋 BOQ Manager"
                            Style="{StaticResource NavButton}" Click="NavButton_Click"/>
                    <Button x:Name="BtnPR" Content="🛒 Purchase Requisition"
                            Style="{StaticResource NavButton}" Click="NavButton_Click"/>
                    <Button x:Name="BtnMCP" Content="🤖 AI Assistant"
                            Style="{StaticResource NavButton}" Click="NavButton_Click"/>
                    <Button x:Name="BtnSettings" Content="⚙️ Settings"
                            Style="{StaticResource NavButton}" Click="NavButton_Click"/>
                </StackPanel>

                <!-- Connection Status -->
                <Border Grid.Row="2" Padding="15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="Connection Status" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <!-- AutoCAD Status -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="10" Height="10"
                                     Fill="{Binding AutoCADStatusColor}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="AutoCAD"/>
                            <TextBlock Grid.Column="2" Text="{Binding AutoCADStatusText}"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        </Grid>

                        <!-- Odoo Status -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="10" Height="10"
                                     Fill="{Binding OdooStatusColor}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Odoo"/>
                            <TextBlock Grid.Column="2" Text="{Binding OdooStatusText}"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        </Grid>

                        <!-- MCP Status -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="10" Height="10"
                                     Fill="{Binding MCPStatusColor}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="MCP Server"/>
                            <TextBlock Grid.Column="2" Text="{Binding MCPStatusText}"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    Padding="20,15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding CurrentPageTitle}"
                               FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Refresh" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,10,0" Command="{Binding RefreshCommand}"/>
                        <Button Content="Help" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Frame -->
            <Frame Grid.Row="1" x:Name="MainFrame" NavigationUIVisibility="Hidden" Margin="20"/>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                    Padding="15,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                               VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>

                    <TextBlock Grid.Column="1" Text="{Binding CurrentDateTime}"
                               VerticalAlignment="Center" Margin="20,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <TextBlock Grid.Column="2" Text="v6.0.0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <Window.Resources>
        <!-- Navigation Button Style -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="3,0,0,0"
                                BorderBrush="Transparent"
                                x:Name="border">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
