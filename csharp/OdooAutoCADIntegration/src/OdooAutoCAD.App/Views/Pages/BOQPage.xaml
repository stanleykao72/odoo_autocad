<Page x:Class="OdooAutoCAD.App.Views.Pages.BOQPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:OdooAutoCAD.App.Converters"
      xmlns:vm="clr-namespace:OdooAutoCAD.App.ViewModels"
      Title="BOQ Manager"
      FontFamily="{StaticResource AppFontFamily}">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:BoolToColorConverter x:Key="BoolToColor"/>
        <converters:ValidationStatusToIconConverter x:Key="StatusToIcon"/>
        <converters:ValidationStatusToColorConverter x:Key="StatusToColor"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibility"/>

        <CollectionViewSource x:Key="GroupedBoqItems"
                              Source="{Binding BoqItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="LayoutName"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="BOQ Manager"
                       FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"/>
            <TextBlock Text="Extract Bill of Quantities from AutoCAD drawings, validate, and push to Odoo"
                       FontSize="14" Margin="0,8,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Row 1: Action Bar — Extract + Validate + Refresh -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Extract Button -->
                <Button Grid.Column="0"
                        Command="{Binding ExtractBOQCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Padding="16,8"
                        MinWidth="180">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Extract from AutoCAD" VerticalAlignment="Center"/>
                        <TextBlock Text=" ..."
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsExtracting, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Button>

                <!-- Validate Button -->
                <Button Grid.Column="1"
                        Command="{Binding ValidateCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Padding="16,8"
                        MinWidth="120"
                        Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Validate All" VerticalAlignment="Center"/>
                        <TextBlock Text=" ..."
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsValidating, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Button>

                <!-- Manage Mappings Button -->
                <Button Grid.Column="2"
                        Content="Manage Mappings"
                        x:Name="ManageMappingsBtn"
                        Click="ManageMappingsBtn_Click"
                        Style="{StaticResource SecondaryButton}"
                        Padding="12,6"
                        Margin="8,0,0,0"/>

                <!-- Progress -->
                <StackPanel Grid.Column="3" Margin="16,0" VerticalAlignment="Center"
                            Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ExtractionStatus}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <Button Content="Cancel"
                                Command="{Binding CancelOperationCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,2"
                                FontSize="11"
                                Margin="8,0,0,0"
                                Visibility="{Binding IsExtracting, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                    <ProgressBar Value="{Binding ExtractionProgress}"
                                 Minimum="0" Maximum="1"
                                 Height="4"
                                 Margin="0,4,0,0"
                                 Foreground="{StaticResource PrimaryBrush}"
                                 Visibility="{Binding IsExtracting, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <!-- Clear All IDs -->
                <Button Grid.Column="4"
                        Content="Clear All IDs"
                        Command="{Binding ClearAllIdsCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Padding="12,6"
                        Margin="0,0,8,0"/>

                <!-- Refresh Status -->
                <Button Grid.Column="5"
                        Content="Refresh Status"
                        Command="{Binding RefreshConnectionStatusCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Padding="12,6"/>
            </Grid>
        </Border>

        <!-- Row 2: Push Controls (always visible, buttons disabled via CanExecute) -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Push to Odoo Button -->
                <Button Grid.Column="0"
                        Command="{Binding PushToOdooCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Padding="16,8"
                        MinWidth="160">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Push to Odoo" VerticalAlignment="Center"/>
                        <TextBlock Text=" ..."
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsPushing, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Button>

                <!-- Retry Writeback Button -->
                <Button Grid.Column="1"
                        Command="{Binding RetryWritebackCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Content="Retry Writeback"
                        Padding="12,6"
                        Margin="8,0,0,0"
                        Visibility="{Binding HasFailedWritebacks, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Push Status + Progress -->
                <StackPanel Grid.Column="2" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PushStatusText}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Value="{Binding PushProgressPercent}"
                                 Minimum="0" Maximum="1"
                                 Height="4"
                                 Margin="0,4,0,0"
                                 Foreground="{StaticResource PrimaryBrush}"
                                 Visibility="{Binding IsPushing, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding PushProgress}"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Visibility="{Binding IsPushing, Converter={StaticResource BoolToVisibility}}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 3: Validation Panel (collapsible) -->
        <Border Grid.Row="3"
                Style="{StaticResource CardPanel}"
                Margin="0,0,0,8"
                Visibility="{Binding IsValidationPanelVisible, Converter={StaticResource BoolToVisibility}}">
            <Expander IsExpanded="True">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Validation Results" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock FontSize="12" Margin="8,0,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} Error(s), {1} Warning(s)">
                                    <Binding Path="ValidationErrorCount"/>
                                    <Binding Path="ValidationWarningCount"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Expander.Header>
                <ListView ItemsSource="{Binding ValidationErrors}"
                          MaxHeight="200"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Severity Icon -->
                                <TextBlock Grid.Column="0" FontSize="14" VerticalAlignment="Center"
                                           HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="!"/>
                                            <Setter Property="Foreground" Value="#C62828"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter Property="Text" Value="⚠"/>
                                                    <Setter Property="Foreground" Value="#F57F17"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Message -->
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="4,0"
                                           FontSize="12" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="[{0}] {1}: {2}">
                                            <Binding Path="LayoutName"/>
                                            <Binding Path="ProductName"/>
                                            <Binding Path="Message"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                                <!-- Map Product Button -->
                                <Button Grid.Column="2"
                                        Content="Map"
                                        Command="{Binding DataContext.MapProductCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Padding="8,2" Margin="4,0"
                                        FontSize="11">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActionType}" Value="Map">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Ignore Button (only for warnings) -->
                                <Button Grid.Column="3"
                                        Content="Ignore"
                                        Command="{Binding DataContext.IgnoreValidationErrorCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Padding="8,2"
                                        FontSize="11">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Expander>
        </Border>

        <!-- Row 4: DataGrid with empty-state overlay -->
        <Grid Grid.Row="4" Margin="0,0,0,8">
            <DataGrid ItemsSource="{Binding Source={StaticResource GroupedBoqItems}}"
                      SelectedItem="{Binding SelectedBoqItem, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      MinHeight="120"
                      BorderThickness="1"
                      BorderBrush="{StaticResource BorderBrush}"
                      Background="White"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                      RowHeaderWidth="0"
                      FontFamily="{StaticResource AppFontFamily}"
                      FontSize="12"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      CanUserSortColumns="True"
                      SelectionMode="Single">

            <!-- Group Style -->
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <Expander IsExpanded="True"
                                                  FontFamily="{StaticResource AppFontFamily}">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Path=Name}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="{StaticResource PrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Path=ItemCount, StringFormat=' ({0} items)'}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsPresenter/>
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>

            <DataGrid.Columns>
                <!-- Status Icon -->
                <DataGridTemplateColumn Header="" Width="30" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ValidationStatus, Converter={StaticResource StatusToIcon}}"
                                       Foreground="{Binding ValidationStatus, Converter={StaticResource StatusToColor}}"
                                       HorizontalAlignment="Center"
                                       FontSize="14"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Code" Binding="{Binding ProductCode}" Width="90"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat=N2}" Width="70"/>
                <DataGridTextColumn Header="UoM" Binding="{Binding UnitOfMeasure}" Width="60"/>
                <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="80"/>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="70"/>
                <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="100"/>
                <DataGridTextColumn Header="Detail ID" Binding="{Binding DetailId}" Width="80"/>

                <!-- Validation Message -->
                <DataGridTemplateColumn Header="Validation" Width="120" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ValidationMessage}"
                                       Foreground="{Binding ValidationStatus, Converter={StaticResource StatusToColor}}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding ValidationMessage}"
                                       FontSize="11"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

            <!-- Empty-state overlay -->
            <TextBlock Text="No BOQ data. Click 'Extract from AutoCAD' to begin."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       IsHitTestVisible="False"
                       Visibility="{Binding HasNoData, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <!-- Row 5: Summary Panel -->
        <Border Grid.Row="5"
                Style="{StaticResource CardPanel}"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Layouts -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding LayoutCount}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Layouts"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Total Items -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding TotalItems}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Total Items"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Valid -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ValidItems}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="#388E3C"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Valid"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Warnings -->
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding WarningItems}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="#F57F17"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Warnings"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Errors -->
                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding InvalidItems}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="#C62828"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Errors"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Skipped -->
                <StackPanel Grid.Column="5" HorizontalAlignment="Center"
                            ToolTip="{Binding SkippedBreakdown}">
                    <TextBlock Text="{Binding SkippedItems}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="#757575"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Skipped"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 6: Push Result -->
        <Border Grid.Row="6"
                Style="{StaticResource CardPanel}"
                Visibility="{Binding LastPushResult, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding LastPushResult}"
                       FontSize="13"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Page>
