<Page x:Class="OdooAutoCAD.App.Views.Pages.OdooPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:OdooAutoCAD.App.Converters"
      xmlns:helpers="clr-namespace:OdooAutoCAD.App.Helpers"
      Title="Odoo Connection"
      FontFamily="{StaticResource AppFontFamily}">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <converters:BoolToColorConverter x:Key="BoolToColor"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibility"/>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Odoo Connection"
                       FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"/>
            <TextBlock Text="Configure and test your Odoo REST API connection (Swagger + Basic Auth)"
                       FontSize="14" Margin="0,8,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                <!-- Connection Status -->
                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Status Indicator -->
                        <Ellipse Grid.Column="0"
                                 Width="16" Height="16"
                                 VerticalAlignment="Center"
                                 Fill="{Binding IsConnected, Converter={StaticResource BoolToColor}}"
                                 Margin="0,0,12,0"/>

                        <!-- Status Text -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Disconnected"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Text" Value="Connected"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding OdooVersion}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Disconnect Button -->
                        <Button Grid.Column="2"
                                Content="Disconnect"
                                Command="{Binding DisconnectCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="16,6"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Border>

                <!-- Connection Settings GroupBox -->
                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Connection Settings"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,20"/>

                        <!-- Swagger URL -->
                        <TextBlock Text="Swagger URL *" Style="{StaticResource SettingsLabel}"/>
                        <TextBox Text="{Binding SwaggerUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 Tag="https://host/api/v1/boq_import_api/swagger.json?token=API_TOKEN&amp;db=DB_NAME"
                                 Margin="0,0,0,4"/>
                        <TextBlock Text="Full Swagger endpoint URL including token and db parameters"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontStyle="Italic"
                                   Margin="0,0,0,12"/>

                        <!-- User Token -->
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                       Text="User Token *"
                                       Style="{StaticResource SettingsLabel}"/>

                            <!-- PasswordBox (hidden mode) -->
                            <PasswordBox Grid.Row="1" Grid.Column="0"
                                         helpers:PasswordBoxHelper.BoundPassword="{Binding UserToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="12,8"
                                         FontFamily="{StaticResource AppFontFamily}"
                                         FontSize="13"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         BorderThickness="1"
                                         Visibility="{Binding ShowToken, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>

                            <!-- TextBox (visible mode) -->
                            <TextBox Grid.Row="1" Grid.Column="0"
                                     Text="{Binding UserToken, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     Visibility="{Binding ShowToken, Converter={StaticResource BoolToVisibility}}"/>

                            <Button Grid.Row="1" Grid.Column="1"
                                    Command="{Binding ToggleTokenVisibilityCommand}"
                                    Margin="8,0,0,0"
                                    Padding="12,8"
                                    MinWidth="70"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource SecondaryButton}">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Show"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowToken}" Value="True">
                                                    <Setter Property="Text" Value="Hide"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                       Text="Authentication token for API access (from token.yaml)"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontStyle="Italic"
                                       Margin="0,4,0,0"/>
                        </Grid>

                        <!-- Remember Me -->
                        <CheckBox Content="Remember credentials"
                                  IsChecked="{Binding RememberMe}"
                                  FontFamily="{StaticResource AppFontFamily}"
                                  FontSize="13"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,8,0,0"/>

                        <TextBlock Text="* Required fields"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontStyle="Italic"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Test Connection Section -->
                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Test Connection"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,16"/>

                        <!-- Test Button with Loading -->
                        <Button Command="{Binding TestConnectionCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left"
                                MinWidth="150"
                                IsEnabled="{Binding IsTesting, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Test Connection" VerticalAlignment="Center"/>
                                <TextBlock Text=" ⟳"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="SpinnerRotation" CenterX="8" CenterY="8"/>
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                                     Storyboard.TargetProperty="Angle"
                                                                     From="0" To="360" Duration="0:0:1"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </TextBlock.Triggers>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Status Panel -->
                        <Border Margin="0,16,0,0"
                                Padding="12"
                                Background="{StaticResource SurfaceBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsSuccess}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                            <Setter Property="Background" Value="#E8F5E9"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusIsSuccess}" Value="False">
                                            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                                            <Setter Property="Background" Value="#FFEBEE"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <TextBlock Text="{Binding StatusMessage}"
                                           TextWrapping="Wrap"
                                           FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusIsSuccess}" Value="True">
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusIsSuccess}" Value="False">
                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- API Version Display -->
                                <TextBlock Text="{Binding OdooVersion, StringFormat='Version: {0}'}"
                                           FontSize="12"
                                           Foreground="#558B2F"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding OdooVersion, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Actions -->
                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Save Settings"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Save your connection settings for future use. Settings are stored securely in the local database."
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,12"/>

                        <Button Content="Save Settings"
                                Command="{Binding SaveSettingsCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left"
                                MinWidth="150"/>
                    </StackPanel>
                </Border>

                <!-- Product Catalog -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Product Catalog"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding SyncStatusMessage}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Visibility="{Binding SyncStatusMessage, Converter={StaticResource StringToVisibility}}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding SyncProductsCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="16,6"
                                    VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Sync Products" VerticalAlignment="Center"/>
                                    <TextBlock Text=" ..."
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsSyncingProducts, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Product DataGrid -->
                        <DataGrid ItemsSource="{Binding Products}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MaxHeight="300"
                                  BorderThickness="1"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                  RowHeaderWidth="0"
                                  FontFamily="{StaticResource AppFontFamily}"
                                  FontSize="12"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  Visibility="{Binding ProductCount, Converter={StaticResource CountToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="100"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                                <DataGridTextColumn Header="UoM" Binding="{Binding UnitOfMeasure}" Width="70"/>
                                <DataGridTextColumn Header="Price" Binding="{Binding ListPrice, StringFormat=N2}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
