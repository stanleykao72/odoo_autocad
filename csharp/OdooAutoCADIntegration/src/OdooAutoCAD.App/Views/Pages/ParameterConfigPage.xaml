<Page x:Class="OdooAutoCAD.App.Views.Pages.ParameterConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:OdooAutoCAD.App.ViewModels"
      xmlns:converters="clr-namespace:OdooAutoCAD.App.Converters"
      FontFamily="Microsoft JhengHei, Segoe UI, Arial"
      d:DataContext="{d:DesignInstance vm:ParameterConfigViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="ParameterConfigPage">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FieldComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="False"/>
            <Setter Property="StaysOpenOnEdit" Value="True"/>
        </Style>
        <Style x:Key="ReadOnlyField" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1565C0"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
    </Page.Resources>

    <Grid Margin="24,16,24,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Action Bar -->
        <Border Grid.Row="0" Margin="0,0,0,8" Padding="12,8" Background="#F0F4FF"
                CornerRadius="4" BorderBrush="#D0D8E8" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Load Options"
                        Command="{Binding LoadOptionsCommand}"
                        Padding="16,7" Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButton}"/>

                <Button Grid.Column="1" Content="Submit to AutoCAD"
                        Command="{Binding SubmitCommand}"
                        Padding="16,7" Margin="0,0,8,0"
                        IsEnabled="{Binding CanSubmit}"/>

                <Button Grid.Column="2" Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Padding="16,7"
                        Style="{StaticResource SecondaryButton}"/>

                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ProgressBar IsIndeterminate="True" Height="3" Width="120" Margin="0,0,0,2"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                    <ProgressBar IsIndeterminate="True" Height="3" Width="120" Margin="0,0,0,2"
                                 Visibility="{Binding IsSubmitting, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                               Foreground="Gray" TextTrimming="CharacterEllipsis" MaxWidth="450"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: Layout info + last result -->
        <StackPanel Grid.Row="1" Margin="0,0,0,4">
            <Border Padding="10,5" Background="#FFF8E1" CornerRadius="3"
                    BorderBrush="#FFE082" BorderThickness="1" Margin="0,0,0,4"
                    Visibility="{Binding LayoutSummary, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}">
                <TextBlock Text="{Binding LayoutSummary}" FontSize="13" Foreground="#F57F17"/>
            </Border>
            <TextBlock Text="{Binding LastSubmitResult}" FontSize="13"
                       Foreground="#2E7D32" TextWrapping="Wrap"
                       Visibility="{Binding LastSubmitResult, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}"/>
        </StackPanel>

        <!-- Row 2: Material Configuration -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Material Configuration" Style="{StaticResource SectionHeader}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Grid.Row="0" Text="Material (Product)" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CbProducts" Grid.Column="0" Grid.Row="1" Style="{StaticResource FieldComboBox}"
                          ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                          DisplayMemberPath="Name"/>

                <TextBlock Grid.Column="2" Grid.Row="0" Text="Unit of Measure" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Column="2" Grid.Row="1" Style="{StaticResource ReadOnlyField}"
                         Text="{Binding Unit, Mode=OneWay}"/>

                <TextBlock Grid.Column="0" Grid.Row="2" Text="Specification" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CbSpecs" Grid.Column="0" Grid.Row="3" Style="{StaticResource FieldComboBox}"
                          ItemsSource="{Binding Specs}"
                          SelectedItem="{Binding SelectedSpec, Mode=TwoWay}"
                          DisplayMemberPath="Value"/>

                <TextBlock Grid.Column="2" Grid.Row="2" Text="Category" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CbCategories" Grid.Column="2" Grid.Row="3" Style="{StaticResource FieldComboBox}"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                          DisplayMemberPath="Value"/>
            </Grid>
        </StackPanel>

        <!-- Row 3: Processing Configuration -->
        <StackPanel Grid.Row="3">
            <TextBlock Text="Processing Configuration" Style="{StaticResource SectionHeader}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Grid.Row="0" Text="Operation Flow" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CbOperationFlows" Grid.Column="0" Grid.Row="1" Style="{StaticResource FieldComboBox}"
                          ItemsSource="{Binding OperationFlows}"
                          SelectedItem="{Binding SelectedOperationFlow, Mode=TwoWay}"
                          DisplayMemberPath="Value"/>

                <TextBlock Grid.Column="2" Grid.Row="0" Text="Surface Treatment" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CbSurfaceTreatments" Grid.Column="2" Grid.Row="1" Style="{StaticResource FieldComboBox}"
                          ItemsSource="{Binding SurfaceTreatments}"
                          SelectedItem="{Binding SelectedSurfaceTreatment, Mode=TwoWay}"
                          DisplayMemberPath="Value"/>
            </Grid>
        </StackPanel>

        <!-- Row 4: Color Configuration -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="Color Configuration" Style="{StaticResource SectionHeader}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Grid.Row="0" Text="Color" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CbColors" Grid.Column="0" Grid.Row="1" Style="{StaticResource FieldComboBox}"
                          ItemsSource="{Binding Colors}"
                          SelectedItem="{Binding SelectedColor, Mode=TwoWay}"
                          DisplayMemberPath="Name"/>

                <TextBlock Grid.Column="2" Grid.Row="0" Text="Color Number" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Column="2" Grid.Row="1" Style="{StaticResource ReadOnlyField}"
                         Text="{Binding ColorNo, Mode=OneWay}"/>
            </Grid>
        </StackPanel>

        <!-- Row 5: Tip -->
        <TextBlock Grid.Row="5" Margin="0,10,0,0"
                   Text="Tip: Type in any dropdown to search by keyword."
                   FontSize="12" Foreground="Gray"/>
    </Grid>
</Page>
