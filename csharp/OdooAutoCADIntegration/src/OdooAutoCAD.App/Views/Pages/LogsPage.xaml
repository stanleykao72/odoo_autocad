<Page x:Class="OdooAutoCAD.App.Views.Pages.LogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:OdooAutoCAD.App.Views.Controls"
      Title="Application Logs"
      FontFamily="{StaticResource AppFontFamily}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Application Logs"
                       FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"/>
            <TextBlock Text="View and filter application-wide log entries from all components"
                       FontSize="14" Margin="0,8,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Full-height Log Panel -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="0">
            <controls:LogPanelControl x:Name="FullLogPanel"/>
        </Border>
    </Grid>
</Page>
