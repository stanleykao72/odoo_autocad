<Page x:Class="OdooAutoCAD.App.Views.Pages.AutoCADPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="AutoCAD Integration"
      FontFamily="{StaticResource AppFontFamily}"
      Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="AutoCAD Integration"
                       FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"/>
            <TextBlock Text="Connect and manage AutoCAD drawing extraction"
                       FontSize="14" Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- Connection Panel -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="30"
                Margin="0,0,0,20">

            <StackPanel>
                <!-- Connection Header -->
                <TextBlock Text="AutoCAD Connection"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,20"/>

                <!-- Status Indicator -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Circle -->
                    <Ellipse Grid.Column="0"
                             Width="16" Height="16"
                             Margin="0,0,12,0"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#F44336"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#4CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <!-- Status Text -->
                    <TextBlock Grid.Column="1"
                               FontSize="16" FontWeight="Medium"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Disconnected"/>
                                <Setter Property="Foreground" Value="#757575"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Text" Value="Connected"/>
                                        <Setter Property="Foreground" Value="#4CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Connection Details -->
                <Border Background="#F5F5F5"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="15"
                        Margin="0,0,0,20">
                    <StackPanel>
                        <!-- AutoCAD Version -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="AutoCAD Version:"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding AutoCADVersion}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="Medium"/>
                        </Grid>

                        <!-- Current Document -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Current Document:"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentDocument}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding CurrentDocument}"/>
                        </Grid>

                        <!-- Document Path -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Document Path:"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding DocumentPath}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DocumentPath}"/>
                        </Grid>

                        <!-- Active Layout -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Active Layout:"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ActiveLayoutName}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="Medium"/>
                        </Grid>

                        <!-- COM Status -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="COM Status:"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ComStatusText}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="Medium"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Status Message -->
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"
                           MinHeight="40"/>

                <!-- Buttons Row: Connect + Open DWG File + Refresh Status -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Connect/Disconnect Button -->
                    <Button Grid.Column="0"
                            Content="{Binding ConnectButtonText}"
                            Command="{Binding ToggleConnectionCommand}"
                            Height="40"
                            FontSize="14" FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="#F44336"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#BDBDBD"/>
                                        <Setter Property="Cursor" Value="Arrow"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Open DWG File Button -->
                    <Button Grid.Column="2"
                            Content="Open DWG File..."
                            Command="{Binding OpenDwgFileCommand}"
                            Height="40"
                            FontSize="14" FontWeight="SemiBold"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="#FF9800"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#BDBDBD"/>
                                        <Setter Property="Cursor" Value="Arrow"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Refresh Status Button -->
                    <Button Grid.Column="4"
                            Content="Refresh"
                            Command="{Binding RefreshConnectionStatusCommand}"
                            Height="40" MinWidth="80"
                            FontSize="13"
                            Cursor="Hand"
                            Style="{StaticResource SecondaryButton}"
                            Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>

                <!-- DWG File Path Display -->
                <TextBlock Text="{Binding DwgFilePath}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DwgFilePath}"
                           Margin="0,8,0,0"
                           Visibility="{Binding IsDwgFileLoaded, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            </StackPanel>
        </Border>

        <!-- PR Project Info Panel (visible when connected) -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="30"
                Margin="0,0,0,20"
                Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="PR Project Info"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PR Number:"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding PrNumber}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontWeight="Medium"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="2"
                            Content="Extract PR Info"
                            Command="{Binding ExtractPRInfoCommand}"
                            Height="32" MinWidth="110"
                            FontSize="12"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Project Name:"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding ProjectName}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontWeight="Medium"/>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Job Working Plan:"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding JobWorkingPlanName}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontWeight="Medium"/>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Project ID:"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding ProjectId}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontWeight="Medium"/>
                </Grid>

                <TextBlock Text="{Binding ProjectLookupStatus}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Clear Table IDs Panel (visible when connected) -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="30"
                Margin="0,0,0,20"
                Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Table ID Management"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Clear IDs (This Layout)"
                            Command="{Binding ClearTableIdsCommand}"
                            Height="36"
                            FontSize="13"
                            Background="#FF9800"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"/>

                    <Button Grid.Column="2"
                            Content="Clear All IDs"
                            Command="{Binding ClearAllTableIdsCommand}"
                            Height="36"
                            FontSize="13"
                            Background="#F44336"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </Grid>

                <TextBlock Text="{Binding ClearIdsStatus}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Layouts and Parameter Extraction Panel (visible when COM connected OR DWG file loaded) -->
        <Grid Grid.Row="4" MinHeight="400" Visibility="{Binding HasDataSource, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Phase 2.2: Layouts Panel -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <TextBlock Grid.Row="0" Text="Layouts"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,15"/>

                    <!-- Refresh Button -->
                    <Button Grid.Row="1"
                            Content="Refresh Layouts"
                            Command="{Binding RefreshLayoutsCommand}"
                            Height="36"
                            Margin="0,0,0,15"
                            FontSize="13"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"/>

                    <!-- Layouts ListView -->
                    <ListView Grid.Row="2"
                              ItemsSource="{Binding Layouts}"
                              SelectedItem="{Binding SelectedLayout}"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Layout Name" Width="180">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Tab Order" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TabOrder}" TextAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <EventSetter Event="MouseDoubleClick" Handler="ListView_MouseDoubleClick"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>

            <!-- Phase 2.3: Parameter Extraction Panel -->
            <Border Grid.Column="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <TextBlock Grid.Row="0" Text="Parameter Extraction"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,15"/>

                    <!-- Extract Button and Status -->
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Extract Parameters"
                                Command="{Binding ExtractParametersCommand}"
                                Height="36"
                                Width="160"
                                Margin="0,0,20,0"
                                FontSize="13"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding ExtractionStatus}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Layout Attributes -->
                    <Border Grid.Row="2"
                            Background="#F5F5F5"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="15"
                            Margin="0,0,0,15"
                            Visibility="{Binding LayoutAttributes.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Layout Details"
                                       FontSize="14" FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding LayoutAttributes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="Medium"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Table Data DataGrid -->
                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding TableData}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1"
                              GridLinesVisibility="All"
                              HeadersVisibility="Column"
                              CanUserResizeRows="False"
                              CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="80"/>
                            <DataGridTextColumn Header="Product No" Binding="{Binding ProductNo}" Width="120"/>
                            <DataGridTextColumn Header="Width" Binding="{Binding Width}" Width="80"/>
                            <DataGridTextColumn Header="Height" Binding="{Binding Height}" Width="80"/>
                            <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="80"/>
                            <DataGridTextColumn Header="Thickness" Binding="{Binding Thickness}" Width="80"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="60"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <!-- DetailId column is hidden -->
                            <DataGridTextColumn Header="Detail ID" Binding="{Binding DetailId}" Width="0" Visibility="Collapsed"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</Page>
