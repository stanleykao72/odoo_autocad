<Window x:Class="OdooAutoCAD.App.Views.Dialogs.ProductMappingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product Mapping"
        Width="600" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        FontFamily="{StaticResource AppFontFamily}">

    <Grid Margin="16">
        <TabControl>
            <!-- Tab 1: Map Product (single mapping) -->
            <TabItem Header="Map Product">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- AutoCAD Product Name (read-only) -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="AutoCAD Product Name" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding AutoCADProductName}" IsReadOnly="True"
                                 Background="#F5F5F5" Padding="8,6"/>
                    </StackPanel>

                    <!-- Search Bar -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 VerticalContentAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1"
                                Content="Search"
                                Command="{Binding SearchCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="16,6"
                                Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Search Results -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding OdooProducts}"
                              SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              BorderThickness="1"
                              BorderBrush="#E0E0E0"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80"/>
                            <DataGridTextColumn Header="UoM" Binding="{Binding UnitOfMeasure}" Width="60"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding ListPrice, StringFormat=N2}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- OK / Cancel -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="OK"
                                Click="OkButton_Click"
                                Style="{StaticResource PrimaryButton}"
                                Padding="24,8"
                                IsEnabled="{Binding HasSelectedProduct}"
                                Margin="0,0,8,0"/>
                        <Button Content="Cancel"
                                Click="CancelButton_Click"
                                Style="{StaticResource SecondaryButton}"
                                Padding="24,8"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 2: Manage Mappings -->
            <TabItem Header="Manage Mappings">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Existing Mappings -->
                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding ProductMappings}"
                              SelectedItem="{Binding SelectedMapping, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              BorderThickness="1"
                              BorderBrush="#E0E0E0"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="AutoCAD Name" Binding="{Binding AutoCADName}" Width="*"/>
                            <DataGridTextColumn Header="Odoo Product ID" Binding="{Binding OdooProductId}" Width="100"/>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding OdooProductName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Add New Mapping -->
                    <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                            Margin="0,8,0,0" Padding="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding NewAutoCADName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" Margin="0,0,4,0"
                                     VerticalContentAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding OdooProducts}"
                                      SelectedItem="{Binding NewSelectedProduct, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      Margin="4,0"/>
                            <Button Grid.Column="2"
                                    Content="Add"
                                    Command="{Binding AddMappingCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="16,6"
                                    Margin="4,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Remove / Close -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Remove Selected"
                                Command="{Binding RemoveMappingCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="16,8"
                                Margin="0,0,8,0"/>
                        <Button Content="Close"
                                Click="CancelButton_Click"
                                Style="{StaticResource SecondaryButton}"
                                Padding="24,8"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
