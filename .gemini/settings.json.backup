{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
         "@modelcontextprotocol/server-github"
      ],
      "env": {
       "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "blender": {
        "command": "uvx",
        "args": [
            "blender-mcp"
        ]
    },
    "autocad-odoo": {
      "command": "python",
      "args": ["C:/odoo/autocad_source/mcp_server_fastmcp.py"],
      "env": {
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  }
}