# 複製此檔為 config/server.yaml（或 c:/odoo/config/server.yaml）後填入實際值。
#
# 注意：url 的 query string 內含 API token，屬於機密。
#       所有 config/*.yaml 都已列入 .gitignore，請勿提交實際設定檔。
#
# 多環境用法：可另存為 server_prod.yaml、server_khs.yaml 等，
#             再由 token.yaml 的 server_file 指向要使用的那一份。
server:
  host: 'your-instance.odoo.com'
  db_name: 'your-database-name'
  url: 'https://your-instance.odoo.com/api/v1/boq_import_api/swagger.json?token=YOUR_API_TOKEN_HERE&db=your-database-name'

  # 指向 token 設定檔
  token_file: 'c:\odoo\config\token.yaml'

  # AutoLISP 輔助檔路徑（依實際安裝位置調整）
  StripMtext_file: 'C:\\odoo\\odoo_autocad\\autolisp\\StripMtext v5-0b.lsp'
  read_csv_file: 'C:\\odoo\\odoo_autocad\\autolisp\\read_csv.lsp'
  contract_product_file: 'C:\\odoo\\odoo_autocad\\autolisp\\contract_product.lsp'
