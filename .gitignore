# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
.log
log/
logs/

# Test outputs
.pytest_cache/
.coverage
htmlcov/
.tox/
.testmondata

# Build outputs
output/
build/

# Installer directory - exclude executables but keep configuration files
installer/*.exe
installer/*.zip
installer/*.msi
# Keep ISS configuration files
!installer/*.iss

# C# build outputs
csharp/publish/
csharp/installer/*.exe
!csharp/installer/*.iss

# Certificates directory - exclude sensitive files but keep documentation
# 注意：certs/*.pfx 只匹配直接子檔案，子目錄需另外處理（重簽時的 backup-* 內含私鑰）
certs/*.pfx
certs/*.p12
certs/*.key
certs/*.pem
certs/codesign.*
certs/*.zip
certs/**/*.pfx
certs/**/*.p12
certs/**/*.key
certs/**/*.pem
certs/backup-*/
# Keep documentation and configuration
!certs/README.txt
!certs/*.txt
!certs/*.bat

# Database files (keep structure, exclude data)
db/*.db
db/*.sqlite
db/*.sqlite3

# Configuration files with sensitive data
# server*.yaml 的 url 內含 API token、token*.yaml 內含使用者 token，
# 因此一律不追蹤實際設定檔，只保留 *.yaml.example 範本。
config/*.yaml
!config/*.yaml.example

# Temporary files
*.tmp
*.temp
*~

# OS specific
.DS_Store
Thumbs.db
desktop.ini

# Git attributes
!.gitattributes